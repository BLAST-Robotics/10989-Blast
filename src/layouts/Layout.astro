---
export interface Props {
	title: string;
}

const { title } = Astro.props;

import "../index.css";
import "../styles/animations.css";
import { Image } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SponsorBar from '../components/SponsorBar.astro';
import sponsorsData from '../data/sponsors.json';
import { Head } from 'astro-capo';
import '@fontsource/dm-sans';

// Import logo images
import placardWhite from '../../public/placardwhite.png';
import placardBlack from '../../public/placardblack.png';
import keystoneLogo from '../../public/keystonelogo.png';
---

<!DOCTYPE html>
	<html lang="en" data-theme="">
	<Head>
		<meta name="astro-view-transitions-enabled" content="true" />
		<meta name="astro-view-transitions-fallback" content="animate" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content="Blast Robotics - Inspiring innovation through FIRST Robotics Competition" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Inspiring innovation through FIRST Robotics Competition." />
		<meta property="og:image" content={new URL('/Blast Robotics-1-Logo Black Square.png', Astro.url).href} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content="Inspiring innovation through FIRST Robotics Competition." />
		<meta property="twitter:image" content={new URL('/Blast Robotics-1-Logo Black Square.png', Astro.url).href} />
		
		<!-- Preload critical images -->
		<link rel="preload" as="image" href="/Blast Robotics-1-Logo Black Square.png" />
		{sponsorsData.slice(0, 4).map((sponsor) => (
			<link rel="preload" as="image" href={sponsor.logo} />
		))}
		
		<!-- Theme color for mobile browsers -->
		<meta name="theme-color" content="#3b82f6" />
		
		<script is:inline>
			// Theme detection and initialization - needs to run immediately to prevent flash
			(function() {
				const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</Head>
	<body>
		<!-- Navigation -->
		<div class="navbar bg-base-100 shadow-lg sticky top-0 z-50 px-2 sm:px-4">
			<div class="navbar-start">
				<div class="dropdown">
					<div tabindex="0" role="button" class="btn btn-ghost btn-sm lg:hidden p-1">
						<i class="bi bi-list text-lg"></i>
					</div>
					<ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
						<li><a href="/">Home</a></li>
						<li><a href="/about">About</a></li>
						<li><a href="/journey">Journey</a></li>
						<li><a href="/#features">Programs</a></li>
						<!-- <li><a href="/#team">Team</a></li> -->
						<li><a href="/partners">Partners</a></li>
						<li><a href="/#calendar">Calendar</a></li>
						<li><a href="/#contact">Contact</a></li>
						<li class="mt-2">
							<a
								href="https://www.paypal.com/donate/?hosted_button_id=C4APA8EZM93MS"
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-warning btn-sm text-sm font-semibold text-neutral-900 shadow-md"
							>
								<i class="bi bi-heart-fill mr-2 text-neutral-900"></i>
								Donate
							</a>
						</li>
					</ul>
				</div>
				<div class="flex items-center gap-2 sm:gap-4">
					<a href="/" class="btn btn-ghost h-auto min-h-0 p-0 hover:bg-transparent flex-shrink-0">
						<Image
							src={placardWhite}
							alt="Blast Robotics Logo"
							class="h-8 sm:h-10 md:h-12 w-auto"
							loading="eager"
							width={200}
							height={200}
							format="png"
							quality={100}
							data-theme-logo
							data-light-src="/placardwhite.png"
							data-dark-src="/placardblack.png"
						/>
					</a>
					<a href="https://www.keystonestemai.org/" target="_blank" rel="noopener noreferrer" class="btn btn-ghost h-auto min-h-0 p-0 hover:bg-transparent flex-shrink-0">
						<Image
						   src={keystoneLogo}
						   alt="Keystone STEM Alliance Logo"
						   class="h-8 sm:h-10 md:h-12 w-auto"
						   loading="eager"
						   width={200}
						   height={200}
						   format="png"
						   quality={100}
						/>
				   </a>
				</div>
			</div>
			<div class="navbar-center hidden lg:flex">
				<ul class="menu menu-horizontal font-semibold text-base px-1">
					<li><a href="/" class="hover:text-primary">Home</a></li>
					<li><a href="/about" class="hover:text-primary">About</a></li>
					<li><a href="/journey" class="hover:text-primary">Journey</a></li>
					<li><a href="/programs" class="hover:text-primary">Programs</a></li>
					<!-- <li><a href="/#team" class="hover:text-primary">Team</a></li> -->
					<li><a href="/partners" class="hover:text-primary">Partners</a></li>
					<li><a href="/#calendar" class="hover:text-primary">Calendar</a></li>
					<li><a href="/#contact" class="hover:text-primary">Contact</a></li>
				</ul>
			</div>
			<div class="navbar-end">
				<!-- Theme Controller -->
				<label class="swap swap-rotate mr-2 sm:mr-4">
					<input type="checkbox" class="theme-controller" id="theme-toggle" />
					<!-- sun icon -->
					<i class="bi bi-sun swap-off text-lg sm:text-2xl"></i>
					<!-- moon icon -->
					<i class="bi bi-moon swap-on text-lg sm:text-2xl"></i>
				</label>
				<a href="/#contact" class="btn btn-primary btn-sm sm:btn-md text-xs sm:text-sm">
					<span class="hidden sm:inline">Join Us</span>
					<span class="sm:hidden">Join</span>
				</a>
				<a
					href="https://www.paypal.com/donate/?hosted_button_id=C4APA8EZM93MS"
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-sm sm:btn-md text-xs sm:text-sm font-semibold ml-2 bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 text-neutral-900 border border-yellow-200 shadow-lg hover:shadow-xl hover:from-amber-200 hover:to-amber-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-yellow-400"
					aria-label="Donate to Blast Robotics via PayPal"
				>
					<i class="bi bi-heart-fill mr-2 hidden sm:inline text-neutral-900"></i>
					Donate
				</a>
			</div>		</div>
		
		<!-- Sponsor Bar -->
		<SponsorBar />
		
		<!-- Main Content -->
		<main>
			<slot />
		</main>

		<Analytics />

		<!-- Footer -->
		<footer class="bg-neutral text-neutral-content">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
					<!-- Logo and About -->
					<div class="lg:col-span-1">
						<div class="flex items-center mb-4">
							<a href="/" class="flex-shrink-0">
								<Image
									src={placardBlack}
									alt="Blast Robotics Logo"
									class="h-16 w-auto"
									width={256}
									height={256}
									loading="lazy"
									format="png"
									quality={100}
								/>
							</a>
						</div>
						<h3 class="text-lg font-bold mb-2">Blast Robotics Team 10989</h3>
						<p class="text-neutral-content/80 text-sm leading-relaxed">
							FRC Community Team serving Mainline Pennsylvania. Building the future through robotics, innovation, and teamwork.
						</p>
					</div>

					<!-- Quick Links -->
					<div>
						<h4 class="text-base font-semibold mb-4 text-neutral-content">Quick Links</h4>
						<ul class="space-y-2">
							<li><a href="/" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Home</a></li>
							<li><a href="/about" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">About</a></li>
							<li><a href="/journey" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Journey</a></li>
							<li><a href="/#features" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Programs</a></li>
						</ul>
					</div>

					<!-- Team -->
					<div>
						<h4 class="text-base font-semibold mb-4 text-neutral-content">Team</h4>
						<ul class="space-y-2">
							<li><a href="/#team" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Meet the Team</a></li>
							<li><a href="/partners" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Partners</a></li>
							<li><a href="/#contact" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">Join Us</a></li>
						</ul>
					</div>

					<!-- Contact & Social -->
					<div>
						<h4 class="text-base font-semibold mb-4 text-neutral-content">Connect</h4>
						<ul class="space-y-2 mb-4">
							<li><a href="mailto:admin@team10989.org" class="text-sm text-neutral-content/80 hover:text-primary transition-colors">admin@team10989.org</a></li>
						</ul>
						<div class="flex space-x-4">
							<a href="https://instagram.com/10989blast" target="_blank" rel="noopener noreferrer" class="text-neutral-content/80 hover:text-primary transition-colors" aria-label="Follow us on Instagram">
								<i class="bi bi-instagram text-xl"></i>
							</a>
							<a href="mailto:admin@team10989.org" class="text-neutral-content/80 hover:text-primary transition-colors" aria-label="Email us">
								<i class="bi bi-envelope text-xl"></i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</footer>
		<div class="footer footer-center p-4 bg-base-300 text-base-content border-t border-base-300">
			<div>
				<p>Copyright © {new Date().getFullYear()} - Blast Robotics Team. All rights reserved.</p>
			</div>
		</div>
		<script is:inline>
			// Theme toggle functionality with multi-logo support
			document.addEventListener('DOMContentLoaded', () => {
				const html = document.documentElement;
				const themeToggle = document.getElementById('theme-toggle');
				const themeLogoElements = Array.from(document.querySelectorAll('[data-theme-logo]'));

				const prefersDarkMedia = window.matchMedia('(prefers-color-scheme: dark)');

				const updateLogos = (theme) => {
					themeLogoElements.forEach((el) => {
						const lightSrc = el.getAttribute('data-light-src') || el.dataset.lightSrc;
						const darkSrc = el.getAttribute('data-dark-src') || el.dataset.darkSrc;
						const target = theme === 'dark' ? darkSrc : lightSrc;
						if (!target) return;

						if (el instanceof HTMLImageElement) {
							if (el.src !== target) {
								el.src = target;
							}
						} else {
							const img = el.querySelector('img');
							if (img && img.src !== target) {
								img.src = target;
							}
						}
					});
				};

				const applyTheme = (theme, persist = true) => {
					html.setAttribute('data-theme', theme);
					if (persist) {
						localStorage.setItem('theme', theme);
					}
					if (themeToggle instanceof HTMLInputElement) {
						themeToggle.checked = theme === 'dark';
					}
					updateLogos(theme);
				};

				const storedTheme = localStorage.getItem('theme');
				const initialTheme = storedTheme || html.getAttribute('data-theme') || (prefersDarkMedia.matches ? 'dark' : 'light');
				applyTheme(initialTheme, false);

				if (themeToggle instanceof HTMLInputElement) {
					themeToggle.checked = initialTheme === 'dark';
					themeToggle.addEventListener('change', () => {
						applyTheme(themeToggle.checked ? 'dark' : 'light');
					});
				}

				const handleSystemThemeChange = (event) => {
					if (!localStorage.getItem('theme')) {
						applyTheme(event.matches ? 'dark' : 'light', false);
					}
				};

				if (typeof prefersDarkMedia.addEventListener === 'function') {
					prefersDarkMedia.addEventListener('change', handleSystemThemeChange);
				} else if (typeof prefersDarkMedia.addListener === 'function') {
					prefersDarkMedia.addListener(handleSystemThemeChange);
				}
			});
		</script>
		
