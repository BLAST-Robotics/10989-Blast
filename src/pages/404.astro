---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - Blast Robotics">
  <section class="hero min-h-[70vh] bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-8xl md:text-9xl font-bold mb-4 text-primary">404</h1>
        <p class="text-2xl md:text-3xl font-semibold mb-4">Page Not Found</p>
        <p class="text-lg text-base-content/70 mb-8">
          The page you're looking for doesn't exist or has been moved.
        </p>
        <a href="/" class="btn btn-primary btn-lg">Go Home</a>
      </div>
    </div>
  </section>
</Layout>
