  <script is:inline>
    (function() {
      var root = document.getElementById('about-calendar-preview');
      if (!root) return;
      var xhr = new XMLHttpRequest();
      xhr.open('GET', '/api/calendar', true);
      xhr.onload = function() {
        if (xhr.status !== 200) return;
        var events, now, upcoming, i, e;
        try { events = JSON.parse(xhr.responseText); } catch(err) { return; }
        if (!events || !events.length) {
          root.innerHTML = '<p style="color:hsl(var(--bc)/0.5);font-size:0.875rem;font-style:italic;">No upcoming events found.</p>';
          return;
        }
        now = new Date();
        upcoming = events
          .filter(function(ev) { return new Date(ev.end || ev.start).getTime() >= now.getTime(); })
          .sort(function(a,b) { return new Date(a.start) - new Date(b.start); })
          .slice(0, 3);
        if (!upcoming.length) {
          root.innerHTML = '<p style="color:hsl(var(--bc)/0.5);font-size:0.875rem;font-style:italic;">No upcoming events.</p>';
          return;
        }
        function fd(d) { return new Date(d).toLocaleDateString(undefined, {weekday:'short', month:'short', day:'numeric'}); }
        function ft(ev) {
          if (ev.allDay) return 'All day';
          var s = new Date(ev.start).toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', timeZone:'America/New_York'});
          return ev.end ? s + ' \u2013 ' + new Date(ev.end).toLocaleTimeString('en-US', {hour:'numeric', minute:'2-digit', timeZone:'America/New_York'}) : s;
        }
        var calUrl = 'https://calendar.google.com/calendar/u/0?cid=YWRtaW5AdGVhbTEwOTg5Lm9yZw';
        var accents = ['hsl(var(--p))', 'hsl(var(--s))', 'hsl(var(--a))'];
        var html = '<div class="about-cal-list">';
        for (i = 0; i < upcoming.length; i++) {
          e = upcoming[i];
          var loc = '';
          if (e.location) {
            loc = (e.location.indexOf('http') === 0 || e.location.indexOf('zoom') !== -1 || e.location.indexOf('meet') !== -1)
              ? 'Online' : e.location;
          }
          html += '<a href="' + calUrl + '" target="_blank" rel="noopener noreferrer" class="about-cal-card" style="border-left-color:' + accents[i % 3] + '">';
          html += '<div class="about-cal-card-date">' + fd(e.start) + '</div>';
          html += '<div class="about-cal-card-title">' + e.summary + '</div>';
          html += '<div class="about-cal-card-footer">';
          html += '<span class="about-cal-chip"><i class="bi bi-clock"></i>' + ft(e) + '</span>';
          if (loc) html += '<span class="about-cal-chip"><i class="bi bi-geo-alt"></i>' + loc + '</span>';
          html += '</div>';
          html += '</a>';
        }
        html += '</div>';
        html += '<a href="' + calUrl + '" target="_blank" rel="noopener noreferrer" class="about-cal-link">View full calendar <i class="bi bi-arrow-right"></i></a>';
        root.innerHTML = html;
      };
      xhr.send();
    })();
  </script>

  <style>
    .about-cal-list {
      display: flex;
