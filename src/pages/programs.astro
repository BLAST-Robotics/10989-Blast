      </div>

      <!-- Safety & Staffing -->
      <div class="mt-6">
        <div class="card bg-success/5 border border-success/20 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4">
              <svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
              Safety is Our #1 Priority
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <h4 class="font-bold mb-3">Supervision & Staffing:</h4>
                <ul class="space-y-2 text-base-content/70">
                  <li>✓ Minimum 4 student counselors from FRC Team 10989</li>
                  <li>✓ Minimum 1 adult supervisor at all times</li>
                  <li>✓ All counselors are passionate, trained team members</li>
                  <li>✓ Parents welcome to stay during camp</li>
                </ul>
              </div>
              <div>
                <h4 class="font-bold mb-3">Safety Certifications:</h4>
                <ul class="space-y-2 text-base-content/70">
                  <li>✓ All staff CPR & First Aid certified (American Red Cross)</li>
                  <li>✓ Background checks for all supervising adults</li>
                  <li>✓ FIRST organization registration verified</li>
                  <li>✓ Daily safety briefings and procedures review</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fundraising & Community Support -->
  <section id="supporting-growth" class="py-12 bg-base-100">
    <div class="container mx-auto px-6">
