---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Programs & Outreach - Blast Robotics" description="Explore Blast Robotics programs including summer camps, STEM tutoring, robot demonstrations, and community outreach in the Mainline Pennsylvania area.">
  <!-- Hero Section -->
  <section class="hero min-h-[50vh] bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Programs & Outreach</h1>
        <p class="text-xl md:text-2xl text-base-content/80">
          Building a comprehensive STEM pipeline and fostering innovation in the Mainline area
        </p>
      </div>
    </div>
  </section>

  <!-- Keystone STEM & AI Alliance Callout -->
  <section class="py-8 bg-base-200/60">
    <div class="container mx-auto px-6">
      <div class="card bg-base-100 shadow-xl border border-base-300">
          <div class="card-body flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="space-y-3">
              <p class="text-sm font-semibold uppercase tracking-wide text-primary">Parent Organization</p>
              <h2 class="text-3xl font-bold">Keystone STEM & AI Alliance</h2>
              <p class="text-base text-base-content/70 max-w-3xl">
                Blast Robotics operates under the Keystone STEM & AI Alliance. Explore their site to discover additional programs,
                resources, and ways to support our broader STEM community.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
              <a
                href="https://keystonestemai.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-lg px-8"
              >Visit KeystoneSTEMAI.org</a>
              <a href="#supporting-growth" class="btn btn-outline btn-lg px-8">View Our Programs</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2026 Blast Camp Section -->
  <section class="py-12 bg-base-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">🚀 2026 Blast Camp — June Session</h2>
        <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
          A 5-day immersive robotics experience fostering innovation and STEM passion in young students
        </p>
        <p class="text-sm italic text-base-content/60 mt-2">
          August 2026 session coming soon — check back for dates!
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mb-6">
        <div>
          <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
              <h3 class="card-title text-2xl mb-4">Camp Overview</h3>
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                  <div>
                    <strong>Who:</strong> Students in grades 4-9 from the Mainline area
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <div>
                    <strong>When:</strong> June 2026 (5-day camp)
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <strong>Time:</strong> Monday-Friday, 9:00 AM - 4:00 PM
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <strong>Location:</strong> 15 Waterloo Avenue, 2nd Floor, Berwyn PA
                  </div>
                </div>
              </div>
              <div class="divider"></div>
              <a
                href="https://docs.google.com/forms/d/1qdwnVLdFZ_W9DJPAMDnNmmj99GNiGHPbJGHPRTg88I0/viewform"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary btn-lg w-full"
              >2026 Camp Registration</a>
            </div>
          </div>
        </div>

        <div>
          <div class="card bg-primary text-primary-content shadow-xl h-full">
            <div class="card-body">
              <h3 class="card-title text-2xl mb-4">2026 Camp Impact</h3>
              <div class="stats stats-vertical shadow bg-primary-content text-primary">
                <div class="stat">
                  <div class="stat-figure text-primary">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="stat-title">Funds Raised</div>
                  <div class="stat-value">$12,000</div>
                  <div class="stat-desc">Supporting team operations</div>
                </div>

                <div class="stat">
                  <div class="stat-figure text-primary">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div class="stat-title">Service Hours</div>
                  <div class="stat-value">600+</div>
                  <div class="stat-desc">Team member dedication</div>
                </div>

                <div class="stat">
                  <div class="stat-figure text-primary">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                  </div>
                  <div class="stat-title">Kids Served</div>
                  <div class="stat-value">40</div>
                  <div class="stat-desc">Will update after August camp</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Camp Details -->
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-xl mb-4">💰 Pricing & Registration</h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span class="font-semibold">Early Registration</span>
                <span class="text-lg font-bold text-primary">$280</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span class="font-semibold">Base Admission</span>
                <span class="text-lg font-bold text-primary">$300</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span>Late Registration</span>
                <span class="text-lg font-bold">$320</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span>Optional Lunch</span>
                <span class="text-sm font-semibold text-right">Bring your own money — counselors escort campers to a nearby spot of their choice</span>
              </div>
            </div>
            <div class="divider"></div>
            <p class="text-sm text-base-content/70">
              Payments handled by <strong>Keystone STEM Alliance Inc.</strong> (EIN 39-3589749).
              Note: Payment is not tax-deductible as it is for a service received.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-xl mb-4">🎒 What to Bring</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Laptop (required)</strong> - Backup devices available if needed</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Lunch money</strong> - Campers bring their own money and choose where to go with their counselor</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Water bottle</strong> - Stay hydrated!</span>
              </li>
            </ul>
            <div class="divider"></div>
            <h4 class="font-bold mb-2">✨ What We Provide:</h4>
            <ul class="space-y-1 text-base-content/70">
              <li>• Snacks (chips, candy, juice)</li>
              <li>• VEX IQ robot kits</li>
              <li>• 3D printing materials</li>
              <li>• All building supplies</li>
              <li>• Camp T-shirt</li>
              <li>• Certificate of completion</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Daily Schedule -->
      <div>
        <h3 class="text-3xl font-bold mb-8 text-center">📅 Daily Activities</h3>
        <div class="space-y-4">
          <!-- Monday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion-2026" checked />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-primary">Day 1</div>
                <span>Making Monday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Counselor check-in, arrivals, introductions & safety review</li>
                <li>• Name Flair Game (creative name tags) & picking STEM activity groups</li>
                <li>• Design + CAD session — take home 3D prints!</li>
                <li>• Intro to VEX IQ Kits — planning bots and starting drivetrain build</li>
                <li>• Guest speaker session</li>
                <li>• Bottle Rockets / Bubbles activity</li>
              </ul>
            </div>
          </div>

          <!-- Tuesday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion-2026" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-secondary">Day 2</div>
                <span>Terrific Tuesday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Safety reminder & day overview</li>
                <li>• Hexabug activity</li>
                <li>• Continue Design + CAD and/or talk with the team</li>
                <li>• Start building mechanisms (claws, parks, etc.) and tuning</li>
                <li>• Outdoor activity block (Hot Seat, Silent Pass, Mad Libs)</li>
                <li>• Spaghetti Bridge challenge</li>
              </ul>
            </div>
          </div>

          <!-- Wednesday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion-2026" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-accent">Day 3</div>
                <span>Well-Planned Wednesday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Bing Bang Business Plan — pitch a business idea to the counselors</li>
                <li>• Scratch and Python demo & seminar</li>
                <li>• Start tuning the bots</li>
                <li>• Popsicle Catapult build</li>
                <li>• Egg Drop Challenge</li>
                <li>• Continue tuning the bots</li>
              </ul>
            </div>
          </div>

          <!-- Thursday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion-2026" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-warning">Day 4</div>
                <span>Tournament Thursday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Team Logo/Name Challenge</li>
                <li>• Snap Circuits / Station / AI Lab</li>
                <li>• Start testing and programming bots</li>
                <li>• Counselor Challenge</li>
                <li>• Continue testing and programming</li>
              </ul>
            </div>
          </div>

          <!-- Friday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion-2026" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-success">Day 5</div>
                <span>Farewell Friday</span>
              </div>
            </div>
            <div class="collapse-content">
              <div class="mt-4 space-y-3">
                <div class="alert alert-warning">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  <span class="font-bold">Competition Day — Practice Matches, Qualifiers & Finals</span>
                </div>
                <ul class="space-y-1 text-base-content/70">
                  <li>• Prep for the competition</li>
                  <li>• Practice matches</li>
                  <li>• Qualifiers 1-3</li>
                  <li>• Alliance selections</li>
                  <li>• Finals (FT2)</li>
                  <li>• Awards ceremony</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

 
      <!-- Daily Schedule -->
      <div>
        <h3 class="text-3xl font-bold mb-8 text-center">📅 Daily Activities</h3>
        <div class="space-y-4">
          <!-- Monday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion" checked />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-primary">Day 1</div>
                <span>Making Monday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Team introductions & safety review</li>
                <li>• Name Flair Game (creative name tags)</li>
                <li>• Introduction to VEX IQ Kits - Planning and starting bot builds</li>
                <li>• <strong>Bridge Blitz:</strong> Spaghetti bridge building challenge</li>
                <li>• Team-building games</li>
              </ul>
            </div>
          </div>

          <!-- Tuesday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-secondary">Day 2</div>
                <span>Terrific Tuesday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• <strong>Print and Present:</strong> Design personalized trinkets for 3D printing</li>
                <li>• Design a toy for donation (community service project)</li>
                <li>• Finalize 3D print designs</li>
                <li>• Complete VEX IQ Kit Bot building in partners</li>
                <li>• <strong>Rock The Block:</strong> Paint rocks for community distribution</li>
              </ul>
            </div>
          </div>

          <!-- Wednesday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-accent">Day 3</div>
                <span>Well-Planned Wednesday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• Bot strategy development</li>
                <li>• Game introduction and demonstration</li>
                <li>• Bot practice sessions</li>
                <li>• <strong>The Great Foil Toss:</strong> Launch a ball of tin foil challenge</li>
                <li>• <strong>Catapult Quest:</strong> Research and design popsicle stick catapults</li>
              </ul>
            </div>
          </div>

          <!-- Thursday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-warning">Day 4</div>
                <span>Tournament Thursday</span>
              </div>
            </div>
            <div class="collapse-content">
              <div class="mt-4 space-y-3">
                <div class="alert alert-warning">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  <span class="font-bold">VEX IQ Bot Tournament (9:00-11:30 AM)</span>
                </div>
                <div class="pl-4 space-y-2 text-base-content/70">
                  <p><strong>Tournament Format:</strong></p>
                  <ul class="list-disc list-inside space-y-1">
                    <li>1v1 Round Robin matches</li>
                    <li>Alliance Selection (2v2)</li>
                    <li>2v2 Best of 3 Playoffs</li>
                    <li>Winning Team 1v1 Showdown</li>
                  </ul>
                  <p class="mt-3"><strong>Awards:</strong> Tournament Winner, Best Driving Skills, Innovation Award, Teamwork Award</p>
                </div>
                <div class="divider"></div>
                <ul class="space-y-1 text-base-content/70">
                  <li>• <strong>Popsicle Link Showdown:</strong> Build the longest popsicle stick chain</li>
                  <li>• Team mural creation</li>
                  <li>• <strong>The Great Human Puzzle:</strong> Human knot teamwork challenge</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Friday -->
          <div class="collapse collapse-arrow bg-base-100 shadow-xl border border-base-300">
            <input type="radio" name="camp-accordion" />
            <div class="collapse-title text-xl font-medium">
              <div class="flex items-center gap-3">
                <div class="badge badge-success">Day 5</div>
                <span>Farewell Friday</span>
              </div>
            </div>
            <div class="collapse-content">
              <ul class="space-y-2 text-base-content/70 mt-4">
                <li>• <strong>Introduction to Python coding</strong> (9:00-11:00 AM)</li>
                <li>• Counselor Challenge competition</li>
