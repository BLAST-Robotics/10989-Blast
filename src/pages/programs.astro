---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Programs & Outreach - Blast Robotics" description="Explore Blast Robotics programs including summer camps, STEM tutoring, robot demonstrations, and community outreach in the Mainline Pennsylvania area.">
  <!-- Hero Section -->
  <section class="hero min-h-[50vh] bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="hero-content text-center">
      <div class="max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Programs & Outreach</h1>
        <p class="text-xl md:text-2xl text-base-content/80">
          Building a comprehensive STEM pipeline and fostering innovation in the Mainline area
        </p>
      </div>
    </div>
  </section>

<!-- Keystone STEM & AI Alliance Callout -->
<section class="py-8 bg-base-200/60">
  <div class="container mx-auto px-6">
    <div class="card bg-base-100 shadow-xl border border-base-300">
      <div class="card-body">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(34rem,0.8fr)] lg:items-center">
  <div class="space-y-3">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">
      Parent Organization
    </p>

    <h2 class="text-3xl font-bold">
      Keystone STEM & AI Alliance
    </h2>

    <p class="max-w-3xl text-base leading-relaxed text-base-content/70">
      Blast Robotics operates under the Keystone STEM & AI Alliance.
      Explore their site to discover additional programs, resources,
      and ways to support our broader STEM community.
    </p>
  </div>

  <div class="grid w-full gap-4 sm:grid-cols-2 lg:self-center">
    <a
      href="https://keystonestemai.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary h-16 w-full px-8 text-base font-bold"
    >
      Visit KeystoneSTEMAI.org
    </a>

    <a
      href="#supporting-growth"
      class="btn btn-outline h-16 w-full px-8 text-base font-bold"
    >
      View Our Programs
    </a>
  </div>
</div>
      </div>
    </div>
  </div>
</section>

  <!-- 2026 Blast Camp Section -->
  <section class="py-12 bg-base-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">🚀 2026 Blast Camp — June Session</h2>
        <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
          A 5-day immersive robotics experience fostering innovation and STEM passion in young students
        </p>
        <p class="text-sm italic text-base-content/60 mt-2">
          August 2026 session coming soon — check back for dates!
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 mb-8 items-stretch">
        <div class="card bg-base-100 shadow-xl border border-base-300 h-full">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4">Camp Overview</h3>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <div><strong>Who:</strong> Students in grades 4-9 from the Mainline area</div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <div><strong>When:</strong> June 2026 (5-day camp)</div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div><strong>Time:</strong> Monday-Friday, 9:00 AM - 4:00 PM</div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <div><strong>Location:</strong> 15 Waterloo Avenue, 2nd Floor, Berwyn PA</div>
              </div>
            </div>
            <!-- 2026 Camp Registration button hidden -->
            <!-- <a
              href="https://docs.google.com/forms/d/1qdwnVLdFZ_W9DJPAMDnNmmj99GNiGHPbJGHPRTg88I0/viewform"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg w-full"
            >2026 Camp Registration</a> -->
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border-2 border-primary h-full">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4 text-primary">2026 Camp Impact</h3>
            <div class="flex flex-col divide-y divide-base-300">
              <div class="flex items-center justify-between gap-4 py-4">
                <div class="flex items-center gap-4">
                  <div class="rounded-full bg-primary/10 p-3">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-sm text-base-content/60">Funds Raised</div>
                    <div class="text-xs text-base-content/50">Supporting team operations</div>
                  </div>
                </div>
                <div class="text-3xl font-bold text-primary">$12,000</div>
              </div>

              <div class="flex items-center justify-between gap-4 py-4">
                <div class="flex items-center gap-4">
                  <div class="rounded-full bg-primary/10 p-3">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-sm text-base-content/60">Service Hours</div>
                    <div class="text-xs text-base-content/50">Team member dedication</div>
                  </div>
                </div>
                <div class="text-3xl font-bold text-primary">600+</div>
              </div>

              <div class="flex items-center justify-between gap-4 py-4">
                <div class="flex items-center gap-4">
                  <div class="rounded-full bg-primary/10 p-3">
                    <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-sm text-base-content/60">Kids Served</div>
                    <div class="text-xs text-base-content/50">Will update after August camp</div>
                  </div>
                </div>
                <div class="text-3xl font-bold text-primary">40</div>
              </div>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-300 h-full">
          <div class="card-body">
            <h3 class="card-title text-xl mb-4">💰 Pricing & Registration</h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span class="font-semibold">Early Registration</span>
                <span class="text-lg font-bold text-primary">$280</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span class="font-semibold">Base Admission</span>
                <span class="text-lg font-bold text-primary">$300</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span>Late Registration</span>
                <span class="text-lg font-bold">$320</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span>Optional Lunch</span>
                <span class="text-sm font-semibold text-right">Bring your own money — counselors escort campers to a nearby spot of their choice</span>
              </div>
            </div>
            <div class="divider"></div>
            <p class="text-sm text-base-content/70">
              Payments handled by <strong>Keystone STEM Alliance Inc.</strong> (EIN 39-3589749).
              Note: Payment is not tax-deductible as it is for a service received.
            </p>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-300 h-full">
          <div class="card-body">
            <h3 class="card-title text-xl mb-4">🎒 What to Bring</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Laptop (required)</strong> - Backup devices available if needed</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Lunch money</strong> - Campers bring their own money and choose where to go with their counselor</span>
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-5 h-5 text-success mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Water bottle</strong> - Stay hydrated!</span>
              </li>
            </ul>
            <div class="divider"></div>
            <h4 class="font-bold mb-2">✨ What We Provide:</h4>
            <ul class="space-y-1 text-base-content/70">
              <li>• Snacks (chips, candy, juice)</li>
              <li>• VEX IQ robot kits</li>
              <li>• 3D printing materials</li>
              <li>• All building supplies</li>
              <li>• Camp T-shirt</li>
              <li>• Certificate of completion</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Daily Schedule removed -->

      <!-- Safety & Staffing -->
      <div class="mt-6">
        <div class="card bg-success/5 border border-success/20 shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4">
              <svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
              Safety is Our #1 Priority
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <h4 class="font-bold mb-3">Supervision & Staffing:</h4>
                <ul class="space-y-2 text-base-content/70">
                  <li>✓ Minimum 4 student counselors from FRC Team 10989</li>
                  <li>✓ Minimum 1 adult supervisor at all times</li>
                  <li>✓ All counselors are passionate, trained team members</li>
                  <li>✓ Parents welcome to stay during camp</li>
                </ul>
              </div>
              <div>
                <h4 class="font-bold mb-3">Safety Certifications:</h4>
                <ul class="space-y-2 text-base-content/70">
                  <li>✓ All staff CPR & First Aid certified (American Red Cross)</li>
                  <li>✓ Background checks for all supervising adults</li>
                  <li>✓ FIRST organization registration verified</li>
                  <li>✓ Daily safety briefings and procedures review</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fundraising & Community Support -->
  <section id="supporting-growth" class="py-12 bg-base-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Supporting Our Growth</h2>
        <p class="text-xl text-base-content/70 max-w-3xl mx-auto">
          As a student-led non-profit, we rely on community support and fundraising to achieve our goals
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 h-full">
          <div class="card-body flex flex-col h-full">
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <h3 class="card-title text-lg mb-2">STEM Tutoring</h3>
            <p class="text-base-content/70 text-sm flex-grow">
              After-school tutoring program offering weekly sessions in math, science, and introductory robotics for students of all levels.
            </p>
            <div class="badge badge-outline mt-4 self-start">Coming Soon</div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 h-full">
          <div class="card-body flex flex-col h-full">
            <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="card-title text-lg mb-2">Robot Demos</h3>
            <p class="text-base-content/70 text-sm flex-grow">
              Interactive demonstrations at community centers and libraries featuring Q&A sessions and hands-on mini-build activities.
            </p>
            <div class="badge badge-outline mt-4 self-start">Upcoming Events</div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 h-full">
          <div class="card-body flex flex-col h-full">
            <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="card-title text-lg mb-2">Workshop Tours</h3>
            <p class="text-base-content/70 text-sm flex-grow">
              Guided tours of our 15 Waterloo Avenue facility for potential sponsors, schools, and families to see our operations firsthand.
            </p>
            <div class="badge badge-outline mt-4 self-start">Schedule a Visit</div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 h-full">
          <div class="card-body flex flex-col h-full">
            <div class="w-14 h-14 bg-success/10 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path>
              </svg>
            </div>
            <h3 class="card-title text-lg mb-2">Community Events</h3>
            <p class="text-base-content/70 text-sm flex-grow">
              Seasonal fundraisers including car washes, bake sales, and restaurant give-back nights partnering with local eateries.
            </p>
            <div class="badge badge-outline mt-4 self-start">Community Partners</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 bg-gradient-to-r from-primary to-secondary text-primary-content">
    <div class="container mx-auto px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Get Involved</h2>
      <p class="text-xl opacity-90 mb-8 max-w-2xl mx-auto">
        Whether you're a student, parent, or community partner, there are many ways to support our mission
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/#contact" class="btn btn-accent btn-lg">Contact Us</a>
        <a href="/partners" class="btn btn-outline btn-lg border-white text-white hover:bg-white hover:text-primary">
          Our Partners
        </a>
      </div>
    </div>
  </section>
</Layout>
