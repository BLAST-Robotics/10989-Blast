---
import { fetchCalendarEvents, getFirstUpcomingEvent } from '../utils/calendar';

const events = import.meta.env.SSR ? await fetchCalendarEvents() : [];
console.log('SSR Events fetched:', events.length);

// Test with hardcoded events if none fetched
const testEvents = events.length > 0 ? events : [
	{
		start: new Date('2025-09-28T10:00:00'),
		end: new Date('2025-09-28T11:00:00'),
		summary: 'Test Event 1',
		description: 'This is a test event',
		location: 'School',
		allDay: false,
	},
	{
		start: new Date('2025-09-29T14:00:00'),
		end: null,
		summary: 'Test Event 2',
		description: 'Another test event',
		location: '',
		allDay: true,
	}
];

const eventsToUse = events.length > 0 ? events : testEvents;
const now = new Date();
const firstUpcoming = getFirstUpcomingEvent(eventsToUse);
const initialSelectedDate = (firstUpcoming?.start ?? now).toISOString();

const serializedEvents = JSON.stringify(
	eventsToUse.map((event) => ({
		start: event.start.toISOString(),
		end: event.end ? event.end.toISOString() : null,
		summary: event.summary,
		description: event.description ?? '',
		location: event.location ?? '',
		allDay: event.allDay,
	}))
);
console.log('Serialized events length:', serializedEvents.length);

const weekdayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---
<section class="py-16 sm:py-24 bg-transparent">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl mx-auto text-center">
			<span class="badge badge-outline badge-primary uppercase tracking-wide">Schedule</span>
			<h2 class="mt-4 text-3xl sm:text-4xl font-bold text-base-content">Team Calendar</h2>
			<p class="mt-3 text-base-content/70 text-base sm:text-lg">
				Stay on top of practices, outreach, and competition prep with our live-updated calendar.
			</p>
		</div>

		<div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)]" data-calendar>
			<div class="rounded-3xl bg-transparent shadow-xl border border-base-200/60">
				<div class="p-6 sm:p-8 h-full flex flex-col">
					<div class="flex items-center justify-between gap-4">
						<button type="button" class="btn btn-ghost btn-sm btn-circle" data-calendar-prev aria-label="Previous month">
							<i class="bi bi-chevron-left text-lg"></i>
						</button>
						<div class="text-lg font-semibold text-base-content" data-calendar-month></div>
						<button type="button" class="btn btn-ghost btn-sm btn-circle" data-calendar-next aria-label="Next month">
							<i class="bi bi-chevron-right text-lg"></i>
						</button>
					</div>

					<div class="mt-6 grid grid-cols-7 text-xs font-semibold uppercase tracking-wide text-base-content/60">
						{weekdayLabels.map((day) => (
							<span class="text-center py-2" role="columnheader">{day}</span>
						))}
					</div>

					<div class="mt-2 rounded-2xl border border-base-200 overflow-hidden">
						<table class="w-full text-center select-none">
							<tbody data-calendar-body></tbody>
						</table>
					</div>

					<div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-base-content/60">
						<span class="inline-flex items-center gap-2">
							<span class="inline-block h-3 w-3 rounded-full bg-primary/80"></span>
							Upcoming event
						</span>
						<span class="inline-flex items-center gap-2">
							<span class="inline-block h-3 w-3 rounded-full border border-dashed border-primary"></span>
							Today
						</span>
					</div>
				</div>
			</div>

			<div class="rounded-2xl shadow-xl bg-transparent">
				<div class="p-6 sm:p-8 h-full flex flex-col">
					<div class="flex items-center justify-between">
						<h3 class="text-xl font-semibold text-base-content">Week Agenda</h3>
						<a
							href="https://calendar.google.com/calendar/embed?src=c_5ced3b5d7c83e41617dce78e1925c590e8b03a35%40group.calendar.google.com"
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline btn-sm"
						>
							Open in Google Calendar
						</a>
					</div>
					<p class="mt-2 text-base-content/60" data-calendar-week-label></p>

					<div class="mt-6 space-y-6 overflow-y-auto" data-calendar-week-events aria-live="polite"></div>
				</div>
			</div>
		</div>
	</div>

	<script type="application/json" data-calendar-events>
		{serializedEvents}
	</script>
	<script type="application/json" data-calendar-config>
		{JSON.stringify({ initialSelectedDate })}
	</script>
	<script type="module">
		function initializeCalendar() {
			console.log('Calendar script starting...');
		const calendarRoot = document.querySelector('[data-calendar]');
		if (!calendarRoot) {
			console.warn('Calendar root element not found.');
			return;
		}

		console.log('Calendar root found, parsing data...');

		const parseJson = (element, fallback) => {
			if (!element) return fallback;
			const raw = element.textContent?.trim();
			if (!raw) return fallback;
			try {
				return JSON.parse(raw);
			} catch (error) {
				console.warn('Unable to parse calendar data', error);
				return fallback;
			}
		};

		const eventsNode = calendarRoot.querySelector('script[data-calendar-events]');
		const configNode = calendarRoot.querySelector('script[data-calendar-config]');

		const eventData = parseJson(eventsNode, []);
		const config = parseJson(configNode, {});
		
		console.log('Parsed eventData:', JSON.stringify(eventData, null, 2));
		console.log('Parsed config:', JSON.stringify(config, null, 2));

		if (!eventData || eventData.length === 0) {
			console.warn('No event data found or parsed. Calendar will not be fully functional.');
		}

		const monthLabel = calendarRoot.querySelector('[data-calendar-month]');
		const prevButton = calendarRoot.querySelector('[data-calendar-prev]');
		const nextButton = calendarRoot.querySelector('[data-calendar-next]');
		const body = calendarRoot.querySelector('[data-calendar-body]');
		const weekLabel = calendarRoot.querySelector('[data-calendar-week-label]');
		const weekContainer = calendarRoot.querySelector('[data-calendar-week-events]');

		if (!monthLabel || !prevButton || !nextButton || !body || !weekLabel || !weekContainer) {
			console.error('One or more required calendar elements are missing from the DOM.');
			return;
		}
		console.log('All calendar DOM elements found.');

			const monthNames = [
				'January',
				'February',
				'March',
				'April',
				'May',
				'June',
				'July',
				'August',
				'September',
				'October',
				'November',
				'December',
			];

			const events = eventData.map((event) => ({
				...event,
				startDate: new Date(event.start),
				endDate: event.end ? new Date(event.end) : null,
			}));

			const eventMap = events.reduce((acc, event) => {
				const key = formatKey(event.startDate);
				if (!acc[key]) acc[key] = [];
				acc[key].push(event);
				return acc;
			}, {});

			for (const key of Object.keys(eventMap)) {
				eventMap[key].sort((a, b) => a.startDate.getTime() - b.startDate.getTime());
			}

			let currentMonth = (() => {
				if (config.initialSelectedDate) {
					const init = new Date(config.initialSelectedDate);
					if (!Number.isNaN(init.getTime())) {
						return new Date(init.getFullYear(), init.getMonth(), 1);
					}
				}
				const today = new Date();
				return new Date(today.getFullYear(), today.getMonth(), 1);
			})();

			let selectedDateKey = (() => {
				if (config.initialSelectedDate) {
					const initial = new Date(config.initialSelectedDate);
					if (!Number.isNaN(initial.getTime())) {
						return formatKey(initial);
					}
				}
				const today = new Date();
				return formatKey(today);
			})();

			function formatKey(date) {
				const year = date.getFullYear();
				const month = String(date.getMonth() + 1).padStart(2, '0');
				const day = String(date.getDate()).padStart(2, '0');
				return `${year}-${month}-${day}`;
			}

			function setSelectedDate(key) {
				selectedDateKey = key;
				renderCalendar();
				renderWeekAgenda();
			}

			function renderCalendar() {
				console.log('renderCalendar called');
				if (!body || !monthLabel) return;

				monthLabel.textContent = `${monthNames[currentMonth.getMonth()]} ${currentMonth.getFullYear()}`;

				const firstDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);
				const leadingSpaces = (firstDay.getDay() + 6) % 7;
				const daysInMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0).getDate();

				let html = '';
				let day = 1;

				for (let week = 0; week < 6; week++) {
					html += '<tr>';
					for (let weekday = 0; weekday < 7; weekday++) {
						const cellIndex = week * 7 + weekday;
						if (cellIndex < leadingSpaces || day > daysInMonth) {
							html += '<td class="py-2"><div class="calendar-day"></div></td>';
						} else {
							const cellDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), day);
							const key = formatKey(cellDate);
							const isToday = key === formatKey(new Date());
							const isSelected = key === selectedDateKey;
							const hasEvents = Boolean(eventMap[key]?.length);

							html += `
								<td class="py-2">
									<button
										type="button"
										class="calendar-day"
										data-date="${key}"
										data-has-events="${hasEvents}"
										data-today="${isToday}"
										data-selected="${isSelected}"
									>
										<span>${day}</span>
									</button>
								</td>
							`;
							day++;
						}
					}
					html += '</tr>';
				}

				body.innerHTML = html;

				body.querySelectorAll('[data-date]').forEach((button) => {
					button.addEventListener('click', () => {
						const dateKey = button.getAttribute('data-date');
						if (dateKey) {
							setSelectedDate(dateKey);
						}
					});
				});
			}

			function renderWeekAgenda() {
				if (!weekContainer || !weekLabel) return;
				const selected = selectedDateKey ? new Date(selectedDateKey) : new Date();
				const { start, end } = getWeekRange(selected);
				weekLabel.textContent = formatWeekLabel(start, end);

				const days = [];
				for (let i = 0; i < 7; i++) {
					const current = new Date(start);
					current.setDate(start.getDate() + i);
					current.setHours(0, 0, 0, 0);
					const key = formatKey(current);
					days.push({ date: current, key, events: eventMap[key] ?? [] });
				}

				const hasAnyEvents = days.some((day) => day.events.length > 0);

				if (!hasAnyEvents) {
					weekContainer.innerHTML = `
						<div class="alert alert-info">
							<div>
								<i class="bi bi-calendar-x text-xl mr-2"></i>
								<span>No events scheduled for this week.</span>
							</div>
						</div>
					`;
					return;
				}

				weekContainer.innerHTML = days
					.map((day) => {
						const heading = day.date.toLocaleDateString(undefined, {
							weekday: 'long',
							month: 'short',
							day: 'numeric',
						});

						const eventsHtml = day.events.length
							? day.events
									.map((event) => {
										const timeLabel = event.allDay
											? 'All day'
											: event.startDate.toLocaleTimeString(undefined, {
													hour: 'numeric',
													minute: '2-digit',
												});

										const endLabel = !event.allDay && event.endDate
											? ` – ${event.endDate.toLocaleTimeString(undefined, {
													hour: 'numeric',
													minute: '2-digit',
												})}`
											: '';

										const tooltipParts = [];
										if (event.description) tooltipParts.push(event.description);
										if (event.location) tooltipParts.push(`Location: ${event.location}`);
										const tooltip = tooltipParts.length ? escapeAttribute(tooltipParts.join('\n')) : '';

										const location = event.location
											? `<span class="event-card__location"><i class="bi bi-geo-alt"></i>${escapeHtml(event.location)}</span>`
											: '';

										return `
											<div class="event-card" ${tooltip ? `title="${tooltip}" data-tooltip="${tooltip}"` : ''}>
												<div class="event-card__meta">
													<span class="event-card__time">${timeLabel}${endLabel}</span>
													${location}
												</div>
												<p class="event-card__summary">${escapeHtml(event.summary)}</p>
												${event.description ? `<p class="sr-only">${escapeHtml(event.description)}</p>` : ''}
											</div>
										`;
									})
									.join('')
							: '<p class="event-card__empty">No events planned.</p>';

						const isSelected = day.key === selectedDateKey;

						return `
							<div class="week-day-group" data-selected="${isSelected}">
								<div class="week-day-header">
									<span class="week-day-name">${heading}</span>
								</div>
								<div class="week-day-events">
									${eventsHtml}
								</div>
							</div>
						`;
					})
					.join('');
			}

			function getWeekRange(date) {
				const start = new Date(date);
				start.setHours(0, 0, 0, 0);
				const day = start.getDay();
				const diff = (day + 6) % 7;
				start.setDate(start.getDate() - diff);

				const end = new Date(start);
				end.setDate(start.getDate() + 6);
				end.setHours(23, 59, 59, 999);
				return { start, end };
			}

			function formatWeekLabel(start, end) {
				const sameYear = start.getFullYear() === end.getFullYear();
				const baseOptions = { weekday: 'long', month: 'long', day: 'numeric' };
				const startLabel = start.toLocaleDateString(undefined, {
					...baseOptions,
					year: sameYear ? undefined : 'numeric',
				});
				const endLabel = end.toLocaleDateString(undefined, {
					...baseOptions,
					year: 'numeric',
				});
				return `Week of ${startLabel} – ${endLabel}`;
			}

			function escapeHtml(value) {
				return value
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#39;')
					.replace(/\n/g, '<br />');
			}

			function escapeAttribute(value) {
				return value
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/"/g, '&quot;')
					.replace(/'/g, '&#39;')
					.replace(/\n/g, ' ')
					.trim();
			}

		prevButton?.addEventListener('click', () => {
				currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1);
				renderCalendar();
				renderWeekAgenda();
		});

		nextButton?.addEventListener('click', () => {
				currentMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
				renderCalendar();
				renderWeekAgenda();
		});

		renderCalendar();
		renderWeekAgenda();

		}
		initializeCalendar();
	</script>

	<style>
		.calendar-day {
			width: 46px;
			height: 46px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: 9999px;
			font-weight: 500;
			color: var(--base-content, currentColor);
			transition: transform 0.15s ease, box-shadow 0.15s ease;
			outline: none;
		}

		.calendar-day[data-date] {
			cursor: pointer;
		}

		.calendar-day[data-selected="true"] {
			background-color: var(--p);
			color: var(--pc);
			box-shadow: 0 10px 25px rgba(59, 130, 246, 0.25);
			font-weight: 700;
		}

		.calendar-day[data-has-events="true"][data-selected="false"] {
			background-color: color-mix(in srgb, var(--p) 18%, transparent);
			color: var(--p);
			font-weight: 600;
		}

		@supports not (color-mix(in srgb, white 50%, black 50%)) {
			.calendar-day[data-has-events="true"][data-selected="false"] {
				background-color: rgba(59, 130, 246, 0.16);
				color: rgb(37, 99, 235);
			}
		}

		.calendar-day[data-today="true"][data-selected="false"] {
			border: 1px dashed var(--p);
		}

		.calendar-day:focus-visible {
			box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.35);
		}

		.week-day-group {
			border: 1px solid color-mix(in srgb, var(--bc, #1f2937) 12%, transparent);
			border-radius: 1rem;
			padding: 1.25rem;
			background: var(--base-100);
			box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.week-day-group[data-selected="true"] {
			border-color: var(--p);
			box-shadow: 0 12px 30px rgba(59, 130, 246, 0.18);
		}

		.week-day-header {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.5rem;
			color: var(--base-content);
		}

		.week-day-name {
			font-weight: 700;
			font-size: 1rem;
		}

		.week-day-events {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.event-card {
			border-radius: 0.85rem;
			border: 1px solid color-mix(in srgb, var(--bc, #1f2937) 10%, transparent);
			background: linear-gradient(135deg, color-mix(in srgb, var(--p) 8%, transparent), transparent);
			padding: 0.9rem 1rem;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
			position: relative;
		}

		.event-card:hover,
		.event-card:focus-visible {
			transform: translateY(-2px);
			box-shadow: 0 12px 28px rgba(59, 130, 246, 0.15);
		}

		.event-card__meta {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.75rem;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--p);
			font-weight: 600;
		}

		.event-card__time {
			font-weight: 700;
		}

		.event-card__location {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			color: color-mix(in srgb, var(--base-content) 70%, transparent);
		}

		.event-card__summary {
			margin-top: 0.35rem;
			font-size: 1rem;
			font-weight: 600;
			color: var(--base-content);
			line-height: 1.35;
		}

		.event-card__empty {
			margin: 0;
			padding: 0.5rem 0;
			font-size: 0.9rem;
			color: color-mix(in srgb, var(--base-content) 55%, transparent);
		}

		.event-card[data-tooltip]::after {
			content: attr(data-tooltip);
			position: absolute;
			left: 1rem;
			bottom: 100%;
			transform: translateY(-0.5rem);
			background: rgba(17, 24, 39, 0.9);
			color: #fff;
			padding: 0.65rem 0.85rem;
			border-radius: 0.75rem;
			font-size: 0.75rem;
			line-height: 1.3;
			min-width: 220px;
			max-width: min(320px, 70vw);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.15s ease, transform 0.15s ease;
			white-space: pre-wrap;
			box-shadow: 0 8px 24px rgba(15, 23, 42, 0.35);
			z-index: 10;
		}

		.event-card[data-tooltip]::before {
			content: '';
			position: absolute;
			left: 1.75rem;
			bottom: calc(100% - 0.4rem);
			width: 10px;
			height: 10px;
			background: rgba(17, 24, 39, 0.9);
			transform: rotate(45deg);
			opacity: 0;
			transition: opacity 0.15s ease;
			z-index: 9;
		}

		.event-card[data-tooltip]:hover::after,
		.event-card[data-tooltip]:focus-visible::after,
		.event-card[data-tooltip]:hover::before,
		.event-card[data-tooltip]:focus-visible::before {
			opacity: 1;
		}

		@media (max-width: 640px) {
			.calendar-day {
				width: 40px;
				height: 40px;
			}

			.week-day-group {
				padding: 1rem;
			}

			.event-card {
				padding: 0.75rem;
			}

			.event-card[data-tooltip]::after {
				left: 0.5rem;
				min-width: 200px;
			}
		}
	</style>
</section>
