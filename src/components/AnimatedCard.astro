---
/**
 * AnimatedCard - Card with hover effects and scroll animations
 * Usage: <AnimatedCard><YourCardContent /></AnimatedCard>
 */
interface Props {
  class?: string;
  delay?: number;
}

const { class: className = '', delay = 0 } = Astro.props;
---

<div 
  class={`animated-card ${className}`}
  data-delay={delay}
>
  <slot />
</div>

<style>
  .animated-card {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  
  .animated-card.will-animate {
    opacity: 0;
    transform: translateY(20px);
  }
  
  .animated-card:hover {
    transform: translateY(-4px);
  }
  
  .animated-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { inView } from 'motion';

  const initAnimatedCards = () => {
    const cards = document.querySelectorAll('.animated-card');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    cards.forEach((card) => {
      if ((card as HTMLElement).dataset.animatedReady === 'true') {
        return;
      }
      (card as HTMLElement).dataset.animatedReady = 'true';

      const delay = parseFloat(card.getAttribute('data-delay') || '0');

      if (prefersReducedMotion) {
        // Skip animation
        return;
      }

      try {
        // Mark card as ready for animation
        card.classList.add('will-animate');
        
        inView(
          card as HTMLElement,
          ({ target }) => {
            setTimeout(() => {
              target.classList.add('in-view');
              target.classList.remove('will-animate');
            }, delay * 1000);
          },
          { amount: 0.2 }
        );
      } catch (error) {
        // Fallback: remove animation classes if motion library fails
        console.warn('Animation error, showing card immediately:', error);
        card.classList.remove('will-animate');
      }
    });
  };

  const bootstrap = () => {
    if (typeof window === 'undefined') return;
    initAnimatedCards();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
  } else {
    bootstrap();
  }

  document.addEventListener('astro:page-load', bootstrap);
</script>
