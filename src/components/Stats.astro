---
// Stats component
---

<section
    class="py-20 bg-base-100 text-base-content">
    <div class="container mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">
                Our Achievements
            </h2>
            <p class="text-xl opacity-90 max-w-2xl mx-auto">
                Numbers that showcase our commitment to excellence in FIRST
                Robotics Competition and STEM education.
            </p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Stat 1 -->
            <div class="text-center">
                <div class="stat">
                    <div class="stat-value text-4xl md:text-6xl font-bold mb-2 text-primary">
                        60+
                    </div>
                    <div class="stat-title text-base-content text-lg font-semibold">
                        Students
                    </div>
                    <div class="stat-desc text-base-content/60 mt-2">
                        People Impacted
                    </div>
                </div>
            </div>

            <!-- Stat 2 -->
            <div class="text-center">
                <div class="stat">
                    <div class="stat-value text-4xl md:text-6xl font-bold mb-2 text-secondary">
                        10K+
                    </div>
                    <div class="stat-title text-base-content text-lg font-semibold">
                        Views
                    </div>
                    <div class="stat-desc text-base-content/60 mt-2">
                        Social Media Outreach
                    </div>
                </div>
            </div>

            <!-- Stat 3 -->
            <div class="text-center">
                <div class="stat">
                    <div class="stat-value text-4xl md:text-6xl font-bold mb-2 text-primary">
                        20+
                    </div>
                    <div class="stat-title text-base-content text-lg font-semibold">
                        Opportunities
                    </div>
                    <div class="stat-desc text-base-content/60 mt-2">
                        Roles and Responisbilites provided
                    </div>
                </div>
            </div>
            <!-- Stat 4 -->
            <div class="text-center">
                <div class="stat">
                    <div class="stat-value text-4xl md:text-6xl font-bold mb-2 text-secondary">
                        40+
                    </div>
                    <div class="stat-title text-base-content text-lg font-semibold">
                        Community Partners
                    </div>
                    <div class="stat-desc text-base-content/60 mt-2">
                        Companies, People and Organizations
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional metrics -->
        <div class="mt-16 grid md:grid-cols-3 gap-8">
            <div class="text-center p-6 bg-base-200 rounded-2xl border border-base-300 hover:border-primary/30 hover:shadow-lg transition-all duration-300">
                <div class="text-3xl font-bold mb-2 text-primary">1000+</div>
                <div class="text-base-content/70">
                    Volunteer Hours
                </div>
            </div>
            <div class="text-center p-6 bg-base-200 rounded-2xl border border-base-300 hover:border-secondary/30 hover:shadow-lg transition-all duration-300">
                <div class="text-3xl font-bold mb-2 text-secondary">10 Teams</div>
                <div class="text-base-content/70">Local Teams In Partnership</div>
            </div>
            <div class="text-center p-6 bg-base-200 rounded-2xl border border-base-300 hover:border-primary/30 hover:shadow-lg transition-all duration-300">
                <div class="text-3xl font-bold mb-2 text-primary">Community</div>
                <div class="text-base-content/70">Focused Team Building</div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
// Animate stat numbers on scroll using Intersection Observer and count-up effect
window.addEventListener("DOMContentLoaded", function () {
    function animateCount(el, target, duration = 1200) {
        let start = 0;
        let startTime = null;
        const isCurrency = /\$/g.test(target);
        const isPlus = /\+/g.test(target);
        const isK = /K/g.test(target);
        const isTeams = /Teams/g.test(target);
        let cleanTarget = target.replace(/[^\d]/g, "");
        let end = parseInt(cleanTarget, 10);
        if (isNaN(end)) return;
        function step(ts) {
            if (!startTime) startTime = ts;
            let progress = Math.min((ts - startTime) / duration, 1);
            let value = Math.floor(progress * end);
            let display = value.toLocaleString();
            if (isCurrency) display = "$" + display;
            if (isK) display += "K";
            if (isPlus) display += "+";
            if (isTeams) display += " Teams";
            el.textContent = display;
            if (progress < 1) {
                requestAnimationFrame(step);
            } else {
                el.textContent = target;
            }
        }
        requestAnimationFrame(step);
    }
    const statNumbers = document.querySelectorAll(".stat-value, .text-3xl.font-bold");
    statNumbers.forEach((el) => {
        el.style.opacity = "0";
        el.style.transform = "scale(0.8)";
        el.style.transition = "opacity 0.7s cubic-bezier(.5,1.5,.5,1), transform 0.7s cubic-bezier(.5,1.5,.5,1)";
    });
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = "1";
                entry.target.style.transform = "scale(1)";
                animateCount(entry.target, entry.target.getAttribute("data-final") || entry.target.textContent.trim());
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.2,
        rootMargin: "0px 0px -40px 0px",
    });
    statNumbers.forEach((el) => {
        el.setAttribute("data-final", el.textContent.trim());
        observer.observe(el);
    });
});
</script>
