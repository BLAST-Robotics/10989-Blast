---
import teamData from "../data/AdultVolunteers.json";
// 👆 Your JSON with { name, role, description, image, initials }

// Helper function to get Bootstrap icon class
function getBootstrapIcon(platform: string): string {
    const icons: Record<string, string> = {
        linkedin: "bi-linkedin",
        github: "bi-github",
        twitter: "bi-twitter",
        email: "bi-envelope",
    };
    return icons[platform] || icons.email;
}
---

<section id="adult-volunteers" class="py-20 bg-base-100">
  <div class="container mx-auto text-center">
    <h2 class="text-3xl font-bold mb-10">Adult Volunteers</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {teamData.map((member, idx) => (
        <div class="card bg-base-200 shadow-md hover:shadow-lg cursor-pointer">
          <div class="card-body items-center text-center">
            {member.image ? (
              <img src={member.image} alt={member.name} class="w-24 h-24 rounded-full object-cover mb-2" />
            ) : (
              <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center mb-2">
                <span class="text-2xl font-bold text-primary-content">{member.initials}</span>
              </div>
            )}
            <h3 class="text-xl font-bold">{member.name}</h3>
            <p class="text-sm text-primary font-medium">{member.role}</p>
                      <div class="flex justify-center space-x-4 mt-4">
                                {Object.entries(member.social).map(
                                    ([platform, url]) =>
                                        url && url !== "#" ? (
                                            <a
                                                href={url}
                                                class="btn btn-circle btn-ghost btn-sm hover:btn-primary transition-colors"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${member.name} on ${platform}`}>
                                                {" "}
                                                <i
                                                    class={`bi ${getBootstrapIcon(platform)} text-lg`}
                                                />
                                            </a>
                                        ) : null
                                )}
                            </div>

            <!-- DaisyUI Modal Trigger -->
            <label for={`modal-${idx}`} class="btn btn-sm mt-3">View Details</label>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- DaisyUI Modals -->
  {teamData.map((member, idx) => (
    <>
      <input type="checkbox" id={`modal-${idx}`} class="modal-toggle" />
      <div class="modal">
  <div class="modal-box relative" style="max-width:800px; width:95vw;">
          <label for={`modal-${idx}`} class="btn btn-sm btn-circle absolute right-2 top-2">✕</label>

          <div class="flex flex-col items-center mb-4">
            {member.image ? (
              <img src={member.image} alt={member.name} class="w-24 h-24 object-cover rounded-full mb-2" />
            ) : (
              <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center mb-2">
                <span class="text-2xl font-bold text-primary-content">{member.initials}</span>
              </div>
            )}
            <h3 class="text-xl font-bold mt-2">{member.name}</h3>
            <p class="text-primary font-semibold">{member.role}</p>
          </div>
          <div class="flex justify-center space-x-4 mt-4">
                                {Object.entries(member.social).map(
                                    ([platform, url]) =>
                                        url && url !== "#" ? (
                                            <a
                                                href={url}
                                                class="btn btn-circle btn-ghost btn-sm hover:btn-primary transition-colors"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`${member.name} on ${platform}`}>
                                                {" "}
                                                <i
                                                    class={`bi ${getBootstrapIcon(platform)} text-lg`}
                                                />
                                            </a>
                                        ) : null
                                )}
                            </div>

          <p class="text-base-content/70 text-justify">{member.description}</p>
        </div>
      </div>
    </>
  ))}
</section>
