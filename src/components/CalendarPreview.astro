---
import {
	fetchCalendarEvents,
	formatEventTimeRange,
	CalendarEvent,
} from '../utils/calendar';

let events: CalendarEvent[] = [];

if (import.meta.env.SSR) {
	events = await fetchCalendarEvents();
}

const now = new Date();
const upcoming = events
	.filter((event) => {
		const end = event.end ?? event.start;
		return end.getTime() >= now.getTime();
	})
	.slice(0, 4);

const [primaryEvent, ...secondaryEvents] = upcoming;

const formatDateLabel = (date: Date) =>
	date.toLocaleDateString(undefined, {
		weekday: 'short',
		month: 'short',
		day: 'numeric',
	});
---

{upcoming.length ? (
	<section
		aria-labelledby="calendar-preview-heading"
		class="calendar-preview"
	>
		<div class="preview-grid">
			<div class="highlight-card" role="group" aria-label="Next upcoming event">
				<p class="highlight-label">Next up</p>
				<h3 id="calendar-preview-heading" class="highlight-title">
					{primaryEvent.summary}
				</h3>
				<dl class="highlight-details">
					<div>
						<dt class="sr-only">Date</dt>
						<dd>
							<i class="bi bi-calendar-event"></i>
							<span>{formatDateLabel(primaryEvent.start)}</span>
						</dd>
					</div>
					<div>
						<dt class="sr-only">Time</dt>
						<dd>
							<i class="bi bi-clock"></i>
							<span>{formatEventTimeRange(primaryEvent)}</span>
						</dd>
					</div>
					{primaryEvent.location && (
						<div>
							<dt class="sr-only">Location</dt>
							<dd>
								<i class="bi bi-geo-alt"></i>
								<span>{primaryEvent.location}</span>
							</dd>
						</div>
					)}
				</dl>
				{primaryEvent.description && (
					<p class="highlight-description">
						{primaryEvent.description}
					</p>
				)}
				<a
					href="#calendar"
					class="highlight-action"
				>
					View full calendar
					<i class="bi bi-arrow-right"></i>
				</a>
			</div>

			{secondaryEvents.length > 0 && (
				<div class="compact-list" role="list" aria-label="Following events">
					{secondaryEvents.map((event) => (
						<article role="listitem" class="compact-event">
							<header>
								<p class="compact-date">{formatDateLabel(event.start)}</p>
								<h4 class="compact-title">{event.summary}</h4>
							</header>
							<p class="compact-meta">
								<i class="bi bi-clock"></i>
								<span>{formatEventTimeRange(event)}</span>
							</p>
							{event.location && (
								<p class="compact-meta">
									<i class="bi bi-geo-alt"></i>
									<span>{event.location}</span>
								</p>
							)}
						</article>
					))}
				</div>
			)}
		</div>
	</section>
) : (
	<section class="calendar-preview empty">
		<div class="empty-state">
			<i class="bi bi-calendar4-week"></i>
			<p>No upcoming events scheduled this week.</p>
		</div>
	</section>
)}

<style>
	.calendar-preview {
		width: min(100%, 1000px);
		margin: 0 auto;
		padding: 1rem;
		color: var(--base-content);
		background: transparent;
	}

	.preview-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 1.5rem);
	}

	.highlight-card {
		grid-column: span 12;
		background: transparent;
		border: none;
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2rem);
		color: var(--base-content);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.highlight-card::after {
		content: none;
	}

	.highlight-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.85;
		font-weight: 600;
	}

	.highlight-title {
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		font-weight: 700;
		line-height: 1.2;
		margin: 0;
	}

	.highlight-details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.highlight-details dd {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
	}

	.highlight-details i {
		font-size: 1rem;
	}

	.highlight-description {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		opacity: 0.95;
		max-width: 48rem;
	}

	.highlight-action {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 9999px;
		padding: 0.6rem 1.25rem;
		background: var(--primary);
		color: var(--primary-content);
		font-weight: 600;
		transition: transform 0.15s ease, background 0.15s ease;
	}

	.highlight-action:hover,
	.highlight-action:focus-visible {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--primary) 80%, black);
	}

	.compact-list {
		grid-column: span 12;
		display: grid;
		gap: 0.75rem;
	}

	.compact-event {
		background: transparent;
		border-radius: 1rem;
		padding: 1rem 1.1rem;
		box-shadow: none;
		border: none;
		display: grid;
		gap: 0.35rem;
	}

	.compact-event header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.compact-date {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--base-content);
		opacity: 0.7;
	}

	.compact-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--base-content);
	}

	.compact-meta {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.85rem;
		color: var(--base-content);
		opacity: 0.8;
	}

	.empty {
		padding-inline: 0;
		background: transparent;
	}

	.empty-state {
		width: min(100%, 420px);
		margin: 0 auto;
		padding: 1.5rem;
		border-radius: 1.25rem;
		border: 1px dashed color-mix(in srgb, var(--bc, #1f2937) 20%, transparent);
		background: transparent;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		color: var(--base-content);
	}

	.empty-state i {
		font-size: 1.75rem;
	}

	@media (min-width: 768px) {
		.highlight-card {
			grid-column: span 7;
		}

		.compact-list {
			grid-column: span 5;
			overflow: hidden;
			max-height: 100%;
		}

		.compact-event {
			background: var(--base-100);
		}
	}

	@media (max-width: 639px) {
		.calendar-preview {
			padding-inline: 0;
		}

		.highlight-card {
			border-radius: 1.25rem;
		}

		.highlight-details {
			grid-template-columns: 1fr;
		}

		.compact-event {
			padding: 0.9rem 1rem;
		}
	}
</style>
