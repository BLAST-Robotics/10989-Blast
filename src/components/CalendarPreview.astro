---
// Calendar Preview
---

<div id="calendar-preview" class="calendar-preview"></div>

<script is:inline>
	(function() {
		var root = document.getElementById('calendar-preview');
		if (!root) return;
		var xhr = new XMLHttpRequest();
		xhr.open('GET', '/api/calendar', true);
		xhr.onload = function() {
			if (xhr.status !== 200) return;
			var events, now, upcoming, primary, secondary, grid, card, label, title, dl, link, arrow, list, art, header, dp, ht, mp, mi, ms, lp, li, ls, i, e, empty, icon, msg, desc;
			try { events = JSON.parse(xhr.responseText); } catch(e) { return; }
			if (!events || !events.length) return;
			now = new Date();
			upcoming = events.filter(function(e) { return new Date(e.end || e.start).getTime() >= now.getTime(); }).sort(function(a,b) { return new Date(a.start).getTime() - new Date(b.start).getTime(); }).slice(0,4);
			primary = upcoming[0];
			secondary = upcoming.slice(1);
			if (!primary) return;

			function fd(d) { return new Date(d).toLocaleDateString(undefined, {weekday:'short',month:'short',day:'numeric'}); }
			function ft(e) {
				if (e.allDay) return 'All day';
				var s = new Date(e.start).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'America/New_York'});
				if (!e.end) return s;
				return s + ' \u2013 ' + new Date(e.end).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'America/New_York'});
			}
			function ad(dl,ic,t) {
				var div = dl.appendChild(document.createElement('div'));
				div.appendChild(document.createElement('dt')).className = 'sr-only';
				var dd = div.appendChild(document.createElement('dd'));
				var icn = dd.appendChild(document.createElement('i'));
				icn.className = ic;
				var sp = dd.appendChild(document.createElement('span'));
				sp.textContent = t;
			}

			grid = root.appendChild(document.createElement('div'));
			grid.className = 'preview-grid';
			card = grid.appendChild(document.createElement('div'));
			card.className = 'highlight-card';
			card.setAttribute('role','group');
			card.setAttribute('aria-label','Next upcoming event');
			label = card.appendChild(document.createElement('p'));
			label.className = 'highlight-label';
			label.textContent = 'Next up';
			title = card.appendChild(document.createElement('h3'));
			title.className = 'highlight-title';
			title.textContent = primary.summary;
			dl = card.appendChild(document.createElement('dl'));
			dl.className = 'highlight-details';
			ad(dl,'bi bi-calendar-event',fd(primary.start));
			ad(dl,'bi bi-clock',ft(primary));
			if (primary.location) ad(dl,'bi bi-geo-alt',primary.location);
			if (primary.description) { desc = card.appendChild(document.createElement('p')); desc.className = 'highlight-description'; desc.textContent = primary.description; }
			link = card.appendChild(document.createElement('a'));
			link.href = 'https://calendar.google.com/calendar/u/0?cid=YWRtaW5AdGVhbTEwOTg5Lm9yZw';
			link.target = '_blank';
			link.rel = 'noopener noreferrer';
			link.className = 'highlight-action';
			link.textContent = 'View full calendar';
			arrow = link.appendChild(document.createElement('i'));
			arrow.className = 'bi bi-arrow-right';

			if (secondary.length) {
				list = grid.appendChild(document.createElement('div'));
				list.className = 'compact-list';
				list.setAttribute('role','list');
				list.setAttribute('aria-label','Following events');
				for (i = 0; i < secondary.length; i++) {
					e = secondary[i];
					art = list.appendChild(document.createElement('article'));
					art.setAttribute('role','listitem');
					art.className = 'compact-event';
					header = art.appendChild(document.createElement('header'));
					dp = header.appendChild(document.createElement('p'));
					dp.className = 'compact-date';
					dp.textContent = fd(e.start);
					ht = header.appendChild(document.createElement('h4'));
					ht.className = 'compact-title';
					ht.textContent = e.summary;
					mp = art.appendChild(document.createElement('p'));
					mp.className = 'compact-meta';
					mi = mp.appendChild(document.createElement('i'));
					mi.className = 'bi bi-clock';
					ms = mp.appendChild(document.createElement('span'));
					ms.textContent = ft(e);
					if (e.location) {
						lp = art.appendChild(document.createElement('p'));
						lp.className = 'compact-meta';
						li = lp.appendChild(document.createElement('i'));
						li.className = 'bi bi-geo-alt';
						ls = lp.appendChild(document.createElement('span'));
						ls.textContent = e.location;
					}
				}
			}
		};
		xhr.send();
	})();
</script>

<style is:global>
	.calendar-preview {
		width: min(100%, 1000px);
		margin: 0 auto;
		padding: 1rem;
		color: var(--base-content);
		background: transparent;
	}

	.preview-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 1.5rem);
	}

	.highlight-card {
		grid-column: span 12;
		background: hsl(var(--b1) / 0.4);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid hsl(var(--bc) / 0.1);
		border-radius: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2rem);
		color: var(--base-content);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: relative;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.highlight-card:hover {
		transform: translateY(-4px) scale(1.01);
		box-shadow: 0 20px 40px hsl(var(--p) / 0.15);
		border-color: hsl(var(--p) / 0.3);
	}

	.highlight-card::after {
		content: none;
	}

	.highlight-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.85;
		font-weight: 600;
	}

	.highlight-title {
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		font-weight: 700;
		line-height: 1.2;
		margin: 0;
	}

	.highlight-details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.highlight-details dd {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
	}

	.highlight-details i {
		font-size: 1rem;
	}

	.highlight-description {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		opacity: 0.95;
		max-width: 48rem;
	}

	.highlight-action {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 9999px;
		padding: 0.6rem 1.25rem;
		background: var(--primary);
		color: var(--primary-content);
		font-weight: 600;
		transition: transform 0.15s ease, background 0.15s ease;
	}

	.highlight-action:hover,
	.highlight-action:focus-visible {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--primary) 80%, black);
	}

	.compact-list {
		grid-column: span 12;
		display: grid;
		gap: 0.75rem;
	}

	.compact-event {
		background: hsl(var(--b1) / 0.3);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-radius: 1rem;
		padding: 1rem 1.1rem;
		border: 1px solid hsl(var(--bc) / 0.08);
		display: grid;
		gap: 0.35rem;
		transition: all 0.3s ease;
	}

	.compact-event:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 25px hsl(var(--p) / 0.12);
		border-color: hsl(var(--p) / 0.2);
	}

	.compact-event header {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.compact-date {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--base-content);
		opacity: 0.7;
	}

	.compact-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--base-content);
	}

	.compact-meta {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.85rem;
		color: var(--base-content);
		opacity: 0.8;
	}

	.empty {
		padding-inline: 0;
		background: transparent;
	}

	.empty-state {
		width: min(100%, 420px);
		margin: 0 auto;
		padding: 1.5rem;
		border-radius: 1.25rem;
		border: 1px dashed color-mix(in srgb, var(--bc, #1f2937) 20%, transparent);
		background: transparent;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		color: var(--base-content);
	}

	.empty-state i {
		font-size: 1.75rem;
	}

	@media (min-width: 768px) {
		.highlight-card {
			grid-column: span 7;
		}

		.compact-list {
			grid-column: span 5;
			overflow: hidden;
			max-height: 100%;
		}

		.compact-event {
			background: var(--base-100);
		}
	}

	@media (max-width: 639px) {
		.calendar-preview {
			padding-inline: 0;
		}

		.highlight-card {
			border-radius: 1.25rem;
		}

		.highlight-details {
			grid-template-columns: 1fr;
		}

		.compact-event {
			padding: 0.9rem 1rem;
		}
	}
</style>
