---
/**
 * AnimatedSection - Fade in elements as they scroll into view
 * Usage: <AnimatedSection><YourContent /></AnimatedSection>
 */
interface Props {
  class?: string;
  delay?: number;
}

const { class: className = '', delay = 0 } = Astro.props;
---

<div 
  class={`animate-section ${className}`}
  data-delay={delay}
>
  <slot />
</div>

<script>
  import { animate, inView } from 'motion';

  const initAnimatedSections = () => {
    const sections = document.querySelectorAll('.animate-section');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    sections.forEach((section) => {
      const element = section as HTMLElement;
      if (element.dataset.animateReady === 'true') {
        return;
      }
      element.dataset.animateReady = 'true';

      const delay = parseFloat(element.getAttribute('data-delay') || '0');

      if (prefersReducedMotion) {
        element.style.opacity = '1';
        element.style.transform = 'none';
        return;
      }

      inView(
        element,
        ({ target }) => {
          animate(
            target,
            { opacity: [0, 1], y: [30, 0] },
            { duration: 0.8, delay, easing: 'ease-out' }
          );
        },
        { amount: 0.3 }
      );
    });
  };

  const bootstrap = () => {
    if (typeof window === 'undefined') return;
    initAnimatedSections();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
  } else {
    bootstrap();
  }

  document.addEventListener('astro:page-load', bootstrap);
</script>
