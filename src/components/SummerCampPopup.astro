---
// Summer Camp Popup Component
import { Image } from 'astro:assets';
import newLogoBlack from '../../public/new_logo_black.png';
---

<!-- Summer Camp Popup -->
<div id="summer-camp-popup" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
	<div class="border-1 border-secondary bg-base-100 rounded-2xl shadow-2xl shadow-secondary max-w-4xl w-full max-h-[90vh] overflow-y-auto transform scale-95 transition-all duration-300">
		<!-- Header with close button and image -->
		<div class="relative p-6 pb-4">
			<button id="close-popup" class="absolute top-4 right-4 btn btn-ghost btn-sm btn-circle z-10">
				<i class="bi bi-x text-xl"></i>
			</button>
			<div class="flex flex-col md:flex-row items-center gap-6">
				<!-- Camp Image - Square -->
				<div class="flex-shrink-0">
					<Image 
						src={newLogoBlack}
						alt="Blast Robotics Summer Camp" 
						class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-xl shadow-lg"
						width={160}
						height={160}
						loading="lazy"
						format="webp"
						quality={85}
					/>
				</div>
				<!-- Text Content -->
				<div class="text-center md:text-left flex-1">
					<h2 class="text-3xl md:text-4xl font-bold text-base-content mb-2">🏕️ Summer Camp 2026 Interest</h2>
					<p class="text-lg text-base-content/70">Be the first to hear when registration opens for next summer.</p>
					<!-- Interest Notice -->
					<div class="mt-3 p-3 bg-secondary/10 border border-secondary/20 rounded-lg">
						<p class="text-sm font-semibold text-secondary flex items-center justify-center md:justify-start">
							Let us know you're planning to join us in 2026.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Content -->
		<div class="px-6 pb-6">
			<!-- Description -->
			<div class="prose prose-lg max-w-none mb-6">
				<p class="text-base-content/80 text-center mb-4">
					🤖 <strong>Discover the exciting world of robotics</strong> with hands-on activities, team challenges, and STEM learning!
				</p>
				<div class="bg-base-200 rounded-xl p-4">
					<h3 class="text-xl font-semibold mb-3 text-center">Why share your interest?</h3>
					<ul class="list-none space-y-2">
						<li class="flex items-center">
							<span class="text-primary mr-2">📬</span>
							Receive early registration updates and reminders
						</li>
						<li class="flex items-center">
							<span class="text-primary mr-2">🗓️</span>
							Help us plan session sizes and scheduling
						</li>
						<li class="flex items-center">
							<span class="text-primary mr-2">🎁</span>
							Unlock exclusive sneak peeks for next summer's activities
						</li>
					</ul>
				</div>
			</div>

			<!-- Action Buttons -->
			<div class="flex flex-col sm:flex-row gap-3 justify-center">
				<a 
					href="https://docs.google.com/forms/d/1qdwnVLdFZ_W9DJPAMDnNmmj99GNiGHPbJGHPRTg88I0/viewform" 
					target="_blank" 
					rel="noopener noreferrer"
					class="btn btn-primary btn-lg flex-1 sm:flex-none">
					<i class="bi bi-envelope-open-heart mr-2"></i>
					Express Interest
				</a>
			</div>

			<!-- Dismissal Options -->
			<div class="text-center mt-6 pt-4 border-t border-base-300">
				<p class="text-sm text-base-content/60 mb-3">Don't want to see this again?</p>
				<div class="flex gap-2 justify-center">
					<button id="remind-later" class="btn btn-ghost btn-sm">
						<i class="bi bi-clock mr-1"></i>
						Remind me later
					</button>
					<button id="dont-show-again" class="btn btn-ghost btn-sm">
						<i class="bi bi-eye-slash mr-1"></i>
						Don't show again
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const popup = document.getElementById('summer-camp-popup');
		if (!popup) {
			return;
		}

		const closeBtn = document.getElementById('close-popup');
		const remindLaterBtn = document.getElementById('remind-later');
		const dontShowAgainBtn = document.getElementById('dont-show-again');
		const storagePrefix = 'summer-camp-2026';
		const dontShowKey = `${storagePrefix}-dont-show`;
		const remindLaterKey = `${storagePrefix}-remind-later`;

		if (localStorage.getItem(dontShowKey) === 'true') {
			return;
		}

		const remindLaterStored = localStorage.getItem(remindLaterKey);
		if (remindLaterStored) {
			const remindTimestamp = parseInt(remindLaterStored, 10);
			if (!Number.isNaN(remindTimestamp) && Date.now() - remindTimestamp < 24 * 60 * 60 * 1000) {
				return;
			}
		}

		const card = popup.querySelector('.bg-base-100');

		const showPopup = () => {
			popup.classList.remove('opacity-0', 'pointer-events-none');
			card?.classList.remove('scale-95');
			card?.classList.add('scale-100');
		};

		const hidePopup = () => {
			popup.classList.add('opacity-0', 'pointer-events-none');
			card?.classList.remove('scale-100');
			card?.classList.add('scale-95');
		};

		setTimeout(showPopup, 2000);

		closeBtn?.addEventListener('click', hidePopup);

		popup.addEventListener('click', (event) => {
			if (event.target === popup) {
				hidePopup();
			}
		});

		remindLaterBtn?.addEventListener('click', () => {
			localStorage.setItem(remindLaterKey, Date.now().toString());
			hidePopup();
		});

		dontShowAgainBtn?.addEventListener('click', () => {
			localStorage.setItem(dontShowKey, 'true');
			hidePopup();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !popup.classList.contains('pointer-events-none')) {
				hidePopup();
			}
		});
	});
</script>
